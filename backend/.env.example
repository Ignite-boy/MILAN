
# ════════════════════════════════════════════════════════════════
# MILAN V7 — LAUNCH CHECKLIST (set these before going live)
# ────────────────────────────────────────────────────────────────
# 1) WELCOME EMAIL from support@milanlife.in — pick ONE provider below
#    and paste its key (RESEND_API_KEY is easy to configure on Voroa).
#    Verify the milanlife.in domain in the provider first.
#    If no key is set, registration STILL works; the mail is just skipped/logged.
#
# 2) MILAN AI ASSISTANT — set ANY ONE of ANTHROPIC_API_KEY / OPENAI_API_KEY /
#    GEMINI_API_KEY (further below) to turn on the AI chat panel + tools.
#    Without a key, AI tools fall back to built-in rule-based responses.
# ════════════════════════════════════════════════════════════════

# Required for production API startup and authoritative persistence.
# Create these values in the hosting provider's secret manager; never commit real values.
MILAN_DATABASE_URL=
# Use a high-entropy secret (at least 32 random bytes). Rotation invalidates sessions.
JWT_SECRET=
# Comma-separated exact browser origins; default production allowlist is milanlife.in + www.
CORS_ORIGIN=https://milanlife.in,https://www.milanlife.in

# Voroa PostgreSQL authoritative cloud storage
MILAN_REQUIRE_CLOUD_DWN=false
MILAN_CLOUD_DWN_ROOT=
MILAN_STORAGE_ROOT=
REAL_DWN_CLOUD_ENDPOINT=
REAL_DWN_CLOUD_API_KEY=
MILAN_CLOUD_DWN_API_KEY=

# ── MILAN V6 AI FEATURES ──
# Add ONE of these keys to enable AI-powered captions, translation & audience targeting
# If neither is set, built-in rule-based fallbacks are used (no API call needed)
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional: Claude (Anthropic) key powers the MILAN AI assistant + smart user features
ANTHROPIC_API_KEY=

# ════════════════════════════════════════════════════════════════
# ── MILAN TRANSACTIONAL EMAIL — all mail is sent FROM support@milanlife.in
# ────────────────────────────────────────────────────────────────
# The app sends: welcome, email verification, password reset, login/security
# alert, and an admin test email. Configure ONE provider below. If none is
# set, mail is logged and skipped (registration/login still work).
#
# Pick ONE:
#   • SMTP   — best when you already have the support@milanlife.in MAILBOX
#              (Zoho / Hostinger / Google Workspace / cPanel). Use its SMTP
#              host/user/pass. nodemailer is already installed.
#   • Resend — easiest on cloud hosts (HTTPS, no SMTP port). Verify the
#              milanlife.in domain in Resend, then paste the API key.
#   • SendGrid — HTTPS API. Verify sender/domain, then paste the API key.
# ════════════════════════════════════════════════════════════════
MAIL_FROM=MILAN <support@milanlife.in>
# The bare address used as envelope sender / SendGrid from / reply-to base.
MAIL_FROM_ADDRESS=support@milanlife.in
# Where replies should go (defaults to MAIL_FROM_ADDRESS).
MAIL_REPLY_TO=support@milanlife.in

# Option A — Resend (recommended on Voroa/cloud)
RESEND_API_KEY=

# Option B — SendGrid
SENDGRID_API_KEY=

# Option C — SMTP (your registered support@milanlife.in mailbox). Examples:
#   Zoho:       SMTP_HOST=smtp.zoho.in        SMTP_PORT=465  SMTP_SECURE=true
#   Hostinger:  SMTP_HOST=smtp.hostinger.com  SMTP_PORT=465  SMTP_SECURE=true
#   Gmail/WS:   SMTP_HOST=smtp.gmail.com      SMTP_PORT=465  SMTP_SECURE=true (use an App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=support@milanlife.in
SMTP_PASS=

# Behaviour toggles
# Send a "new sign-in" security alert email on every login (set false to disable).
MAIL_LOGIN_ALERTS=true
# Status flag shown in the mail/admin configuration.
# New accounts must verify email before password or ID3 login; existing accounts
# were grandfathered by the email-auth database migration.
MAIL_REQUIRE_VERIFICATION=true
# Public base URL used to build verify / reset links in emails.
PUBLIC_BASE_URL=https://milanlife.in

# Admin dashboard token (used by /admin-users and the Mail test panel).
ADMIN_TOKEN=change-this-admin-token

# Video upload/playback
# Facebook-style upload: browser sends videos in resumable chunks; server accepts first, then processes video compatibility in background.
MILAN_UPLOAD_CHUNK_BYTES=6291456
MILAN_CHUNK_UPLOAD_THRESHOLD_BYTES=8388608
MILAN_DEFER_VIDEO_PROCESSING=true
MILAN_SYNC_VIDEO_PROCESS_BYTES=157286400
MILAN_BACKGROUND_PROCESS_DELAY_MS=1500
MILAN_TRANSCODE_VIDEO=true
MILAN_FORCE_UPLOAD_TRANSCODE=true
MILAN_UPLOAD_REQUEST_TIMEOUT_MS=1800000
MAX_MEDIA_BYTES=5242880000

MILAN_TRANSCODE_TIMEOUT_MS=180000
MILAN_MAX_TRANSCODE_BYTES=5368709120
MILAN_TRANSCODE_MAX_WIDTH=1280
MILAN_UNIVERSAL_STREAM_FIX_BYTES=536870912
MILAN_UNIVERSAL_STREAM_WAIT_MS=60000
# V54 video playback: keep standard HTTP Range streaming and ffmpeg conversion enabled.
MILAN_V54_NOTE=standard-range-video-streaming-enabled

# ── MILAN DWN PROTOCOL STATUS ──
# The main Express API uses Voroa PostgreSQL-authoritative application persistence.
# A signed DWN protocol engine is not currently integrated/verified in this path.
# Setting this flag to true does not install or enable a real protocol engine.
MILAN_REAL_DWN_ENGINE=false
# Optional local/cache data-root settings; hosted service local files are not durable.
# MILAN_REAL_DWN_ENGINE_ROOT=/var/data/milan-dwn/real-dwn-engine

PLAN_500_AMOUNT=250
PLAN_1GB_AMOUNT=500
# Generate a unique random secret; keep it stable across instances.
# Rotation requires re-encrypting stored portable DIDs.
DID_KEY_ENCRYPTION_SECRET=

# Direct MILAN Pay UPI intent checkout; use a bank-linked UPI ID enabled for collections.
MILAN_PAY_MERCHANT_NAME="MILAN Pay"
MILAN_PAY_UPI_ID=
# Optional 4-digit MCC assigned by the acquiring bank; required for the documented Google Pay iOS UPI intent.
MILAN_PAY_MCC=
# Keep false until the bank/acquirer confirms merchant onboarding and iOS device QA succeeds.
MILAN_PAY_GOOGLE_PAY_IOS_ENABLED=false

# Optional self-hosted Travel-Agent API URL ending in /chat
TRAVEL_AGENT_URL=
