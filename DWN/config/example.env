# Standalone C++ DWN prototype configuration.
# Canonical CMake target uses LevelDB. PostgreSQL source is excluded from this target;
# these settings do not enable or select PostgreSQL support.
DWN_HOST=0.0.0.0
DWN_PORT=3000
DWN_LOG_LEVEL=info
DWN_SERVER_NAME=milan-DWN
DWN_LEVELDB_ROOT=./data/leveldb
DWN_TLS_ENABLED=false
DWN_MAX_REQUEST_BYTES=4194304
DWN_MAX_RECORD_BYTES=2097152
DWN_RATE_LIMIT=120
