{
  "outputDirectory": "frontend",
  "rewrites": [
    {
      "source": "/api/auth/:action",
      "destination": "https://milan-api-4n3n.onrender.com/api/auth/:action"
    },
    {
      "source": "/api/profile",
      "destination": "https://milan-api-4n3n.onrender.com/api/profile"
    },
    {
      "source": "/api/cloud-dwn/:path*",
      "destination": "https://milan-api-4n3n.onrender.com/api/cloud-dwn/:path*"
    },
    {
      "source": "/api/dwn/:path*",
      "destination": "https://milan-api-4n3n.onrender.com/api/dwn/:path*"
    },
    {
      "source": "/api/music/suggest",
      "destination": "/api/music/suggest"
    },
    {
      "source": "/api/music/search",
      "destination": "/api/music/search"
    },
    {
      "source": "/api/music/:path*",
      "destination": "/api/music/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/music",
      "destination": "/music.html"
    },
    {
      "source": "/milan-music",
      "destination": "/music.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/decentralized-social-media",
      "destination": "/decentralized-social-media.html"
    },
    {
      "source": "/social-media-privacy",
      "destination": "/social-media-privacy.html"
    },
    {
      "source": "/private-social-network",
      "destination": "/private-social-network.html"
    },
    {
      "source": "/what-is-web5",
      "destination": "/what-is-web5.html"
    },
    {
      "source": "/best-social-media-apps",
      "destination": "/best-social-media-apps.html"
    },
    {
      "source": "/decentralized-social-network",
      "destination": "/decentralized-social-network.html"
    },
    {
      "source": "/web5-ecosystem",
      "destination": "/web5-ecosystem.html"
    },
    {
      "source": "/chat",
      "destination": "/chat/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/who-is-the-founder-of-milan",
      "destination": "/who-is-the-founder-of-milan.html"
    },
    {
      "source": "/disclaimer",
      "destination": "/disclaimer.html"
    },
    {
      "source": "/cookie-policy",
      "destination": "/cookie-policy.html"
    },
    {
      "source": "/(.*)",
      "destination": "/$1"
    }
  ],
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/app.html",
      "destination": "/app",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
