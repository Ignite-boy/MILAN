# --- LLM provider ---
# "gemini" (free tier, no credit card needed - recommended if you don't want to pay)
# "ollama" (local/free, needs Ollama running with a tool-calling model pulled)
# "openai" (hosted, needs OPENAI_API_KEY and billing)
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
OLLAMA_MODEL=qwen2.5
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# --- Embeddings provider ---
# "gemini", "ollama" (needs an embedding model pulled, e.g. nomic-embed-text),
# "openai", or "hash" (zero-dependency fallback for local dev/testing,
# NOT semantically meaningful, do not use for a real demo)
EMBEDDING_PROVIDER=gemini
GEMINI_EMBED_MODEL=models/gemini-embedding-001
OLLAMA_EMBED_MODEL=nomic-embed-text
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Optional external tool APIs (tools fall back to mock/static data if unset) ---
OPENWEATHER_API_KEY=
TAVILY_API_KEY=

# --- Behaviour ---
ENABLE_AUTO_PREFERENCE_EXTRACTION=true
