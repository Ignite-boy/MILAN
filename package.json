{
  "name": "milan-decentralized-social-space",
  "version": "70.0.0",
  "description": "MILAN application and MILAN-ONE ecosystem workspace; static HTML/CSS/JS frontend, Express API, Voroa PostgreSQL persistence, and experimental companion components.",
  "main": "backend/server.js",
  "scripts": {
    "start": "node -r ./backend/services/avatar-hydration-guard.js backend/server.js",
    "dev": "node -r ./backend/services/avatar-hydration-guard.js backend/server.js",
    "mail:test": "node backend/scripts/test-mail.js",
    "mail:diagnose": "node backend/scripts/smtp-diagnose.js",
    "build": "node scripts/verify-build.js",
    "test:chat": "node scripts/chat-self-test.js",
    "test:payment": "node scripts/payment-self-test.js",
    "test:milan-pay": "node scripts/milan-pay-self-test.js",
    "test:security": "node --test scripts/security-self-test.js",
    "test:upload": "node scripts/upload-chunk-self-test.js && node scripts/upload-chunk-self-test.js --shared && node scripts/resumable-upload-store-self-test.js && node scripts/resumable-media-commit-self-test.js",
    "test:distributed-rate-limit": "node scripts/distributed-rate-limit-self-test.js",
    "test:feed-pagination": "node scripts/feed-pagination-self-test.js",
    "test:persistence-visibility": "node scripts/persistence-visibility-self-test.js",
    "test:ai-boundary": "node scripts/ai-best-time-self-test.js",
    "test:session-token": "node scripts/session-token-self-test.js",
    "test:media-limits": "node scripts/media-limit-contract-self-test.js",
    "test:readiness": "node scripts/readiness-contract-self-test.js"
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.3.2",
    "@tbd54566975/dwn-sdk-js": "^0.5.2",
    "@web5/crypto": "^1.0.6",
    "@web5/dids": "^1.2.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "ioredis": "^6.0.0",
    "ipfs-unixfs-exporter": "13.1.0",
    "jsonwebtoken": "^9.0.0",
    "multer": "^2.3.0",
    "nodemailer": "^10.2.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.4",
    "ws": "^8.21.0"
  },
  "overrides": {
    "uuid": "^11.1.0",
    "ipfs-unixfs-exporter": "13.1.0",
    "ajv": "^8.18.0",
    "lodash": "^4.18.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "allowScripts": {
    "classic-level": true,
    "ffmpeg-static": true,
    "ffprobe-static": true
  }
}
